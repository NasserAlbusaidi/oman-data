      "indicators": {
        "key": 1000010,
        "name": "GDP at Market Prices",
        "id": "200",
        "full-name": "",
        "description": "The total value of goods and services produced inside the country (total production) after extracting the value of the raw materials and other goods and services consumed during a specific production period (normally one year) and equals the (added value of all the producers inside the Sultanate).",
        "unit": "Mn.R.O",
        "short-name": "",
        "short-description": "",
        "frequencies": "quarterly",
        "methodology": "= Value Added of all resident producers in different economic activities at current (constant) prices inside the Sultanate + net production and import taxes",
        "source-name": "Government departments, financial and non-financial establishments, as well as non-profitable organisations",
        "source-link": "",
        "اسم": "الناتج المحلي بسعر السوق",
        "الاسم-الكامل": "",
        "وصف": "هوالقيمة الإجمالية للسلع والخدمات المنتجة داخل البلد (إجمالي الإنتاج) ناقصا قيمةالمواد الخام والسلع والخدمات الأخرى التي تم استهلاكها أثناء عملية الإنتاج(الإستهلاك الوسيط) خلال فترة محددة عادة ما تكون سنة واحدة ويساوي (القيمةالمضافة لكافة المنتجين المقيمين).</span>",
        "الوحدة": "مليون ريال عماني",
        "الدورية": "ربع سنوي",
        "منهجية-الاحتساب": "= القيم المضافة لكافة المنتجين المقيمين لمختلف الأنشطة الإقتصادية بالأسعار الجارية (الثابتة) + الضرائب الصافية على الإنتاج والواردات.",
        "اسم-مصدر": "جهات حكومية ومؤسسات مالية ومؤسسات غير مالية، والهيئات التي لا تهدف للربح وتخدم العائلات والأسر المعيشية."
      },
      "price-type": {
        "key": 1000010,
        "name": "Current Prices",
        "id": "200",
        "اسم": "الأسعار الجارية"
      },
