      "indicators": {
        "key": 1000010,
        "name": "Index Value",
        "id": "200",
        "full-name": "",
        "description": "A statistical indicator that measures the average change in the prices of Non_Oil goods produced and sold by producers. It relies on a basket of commodity products - a wide range of representative products whose prices are collected on a quarterly basis from the producing companies. They represent the industrial production prices in the comparison period vis-à-vis the base period.",
        "unit": "",
        "short-name": "",
        "short-description": "",
        "frequencies": "Quartarly, Annual",
        "methodology": "",
        "source-name": "National Center For Statistics and Information - Quarterly Survey of Non_Oil Producer price Index.",
        "source-link": "",
        "اسم": "قيمة المؤشر",
        "الاسم-الكامل": "",
        "وصف": "هو مؤشر احصائي يقيس متوسط التغير الذي يطرأ على أسعار السلع غير النفطية المنتجة والمباعة بواسطة المنتجين. ويعتمد هذا المؤشر على سلة من المنتجات السلعية - مجموعة واسعة من المنتجات الممثلة - والتي تجمع أسعارها بشكل ربع سنوي من الشركات المنتجة، حيث تمثل أسعار الإنتاج الصناعي في فترة زمنية تسمى فترة المقارنة منسوباً إلى فترة أخرى تسمى فترة الأساس.",
        "الوحدة": "نسبة مئوية",
        "الدورية": "ربعي - سنوي",
        "منهجية-الاحتساب": "",
        "اسم-مصدر": "المركز الوطني للإحصاء والمعلومات - المسح الربع سنوي للأرقام القياسية لأسعار المنتجين غير النفطية."
      },
      "commodities": {
